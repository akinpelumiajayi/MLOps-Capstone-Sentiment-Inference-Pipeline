FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit==1.45.1 \
    requests==2.32.3 \
    pandas==2.2.3 \
    plotly==5.24.1

COPY streamlit_app/ ./streamlit_app/

ENV API_URL=http://api:8000

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
